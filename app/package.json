{
	"name": "ble-label-maker",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "A web page for designing and printing labels on Bluetooth label makers, using Web Bluetooth.",
	"scripts": {
		"test": "node --test \"test/*.test.js\"",
		"test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.e2e.js\"",
		"coverage": "c8 --reporter=none npm test && c8 --clean=false --reporter=none npm run test:e2e && c8 report --check-coverage",
		"serve": "node serve.js",
		"cert": "node tools/make-cert.mjs",
		"serve:lan": "node serve.js --lan",
		"lint": "eslint . && prettier --check . && tsc -p jsconfig.json",
		"format": "prettier --write . && eslint --fix .",
		"precache": "node tools/make-precache.mjs",
		"ui-icons": "node tools/make-ui-icons.mjs",
		"name": "node tools/apply-name.mjs && prettier --write index.html manifest.webmanifest",
		"typecheck": "tsc -p jsconfig.json"
	},
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/web-bluetooth": "0.0.22",
		"@zxing/library": "0.23.0",
		"axe-core": "4.14.0",
		"c8": "12.0.0",
		"eslint": "10.13.0",
		"globals": "17.13.0",
		"lucide-static": "1.56.0",
		"prettier": "3.9.10",
		"puppeteer-core": "25.13.0",
		"typescript": "7.0.2"
	}
}
